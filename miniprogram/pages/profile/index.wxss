page { background: #f3f6f4; color: #17231f; }.profile-shell { height: 100vh; background: #f3f6f4; }.profile-scroll { height: 100%; box-sizing: border-box; padding: 20rpx 20rpx calc(35rpx + env(safe-area-inset-bottom)); }.profile-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 8rpx 28rpx; }.profile-identity { flex: 1; min-width: 0; }.profile-kicker { color: #83a093; font-size: 19rpx; letter-spacing: 2rpx; }.profile-name { margin-top: 10rpx; font-size: 42rpx; font-weight: 700; }.profile-phone { display: flex; align-items: center; color: #8b9c92; font-size: 23rpx; margin-top: 11rpx; }.phone-status-dot { width: 12rpx; height: 12rpx; margin-right: 9rpx; background: #4e9c72; border-radius: 50%; }.profile-edit { color: #789087; font-size: 21rpx; }.member-banner { padding: 28rpx 27rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(120deg,#17362a,#2c654b); display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }.member-eyebrow { color: #add1b6; font-size: 17rpx; letter-spacing: 2rpx; }.member-title { font-size: 31rpx; font-weight: 700; margin-top: 12rpx; }.member-desc { font-size: 20rpx; color: #c3dfca; margin-top: 8rpx; }.member-banner button { margin: 0; padding: 0 21rpx; height: 64rpx; line-height: 64rpx; border-radius: 36rpx; color: #294634; background: #f5ca42; font-size: 21rpx; }.member-banner button::after { border: none; }.member-banner button text { font-size: 24rpx; font-weight: 700; }.panel { background: #fff; border-radius: 28rpx; padding: 27rpx 26rpx; margin-bottom: 18rpx; box-shadow: 0 10rpx 28rpx rgba(20,72,43,.05); }.card-title-row { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1rpx solid #edf2ef; padding-bottom: 21rpx; }.card-title { font-size: 31rpx; font-weight: 700; }.card-caption { color: #91a199; font-size: 20rpx; }.order-stats { display: grid; grid-template-columns: repeat(5,1fr); text-align: center; padding-top: 26rpx; }.stat-icon { font-size: 42rpx; height: 52rpx; }.stat-blue { color: #668ca8; }.stat-lilac { color: #8979a3; }.stat-amber { color: #b18a62; }.stat-slate { color: #778c95; }.stat-green { color: #5c9370; }.stat-number { color: #436154; font-size: 24rpx; font-weight: 700; margin-top: 5rpx; }.stat-label { color: #6f8178; font-size: 19rpx; margin-top: 6rpx; }.function-grid { display: grid; grid-template-columns: repeat(3,1fr); row-gap: 27rpx; text-align: center; padding-top: 27rpx; color: #687a70; font-size: 20rpx; }.function-icon { font-size: 43rpx; height: 53rpx; }.function-blue { color: #668ca8; }.function-lilac { color: #8979a3; }.function-slate { color: #778c95; }.function-amber { color: #b18a62; }.function-teal { color: #5d9586; }.function-rose { color: #a58289; }.function-olive { color: #8f9270; }.admin-note { color: #9aa9a0; text-align: center; font-size: 18rpx; padding: 0 25rpx 25rpx; }.fade-in { animation: rise .45s ease both; }.delay-1 { animation-delay: .08s; } @keyframes rise { from { opacity: 0; transform: translateY(15rpx); } to { opacity: 1; transform: translateY(0); } }
