page { background: #f3f6f4; color: #17231f; }.profile-shell { height: 100vh; background: #f3f6f4; }.profile-scroll { height: 100%; box-sizing: border-box; padding: 20rpx 20rpx calc(35rpx + env(safe-area-inset-bottom)); }.profile-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 8rpx 28rpx; }.profile-identity { flex: 1; min-width: 0; }.profile-kicker { color: #83a093; font-size: 19rpx; letter-spacing: 2rpx; }.profile-name { margin-top: 10rpx; font-size: 42rpx; font-weight: 700; }.profile-phone { display: flex; align-items: center; color: #8b9c92; font-size: 23rpx; margin-top: 11rpx; }.phone-status-dot { width: 12rpx; height: 12rpx; margin-right: 9rpx; background: #4e9c72; border-radius: 50%; }.profile-edit { color: #789087; font-size: 21rpx; }.member-banner { padding: 28rpx 27rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(120deg,#17362a,#2c654b); display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }.member-eyebrow { color: #add1b6; font-size: 17rpx; letter-spacing: 2rpx; }.member-title { font-size: 31rpx; font-weight: 700; margin-top: 12rpx; }.member-desc { font-size: 20rpx; color: #c3dfca; margin-top: 8rpx; }.member-banner button { margin: 0; padding: 0 21rpx; height: 64rpx; line-height: 64rpx; border-radius: 36rpx; color: #294634; background: #f5ca42; font-size: 21rpx; }.member-banner button::after { border: none; }.member-banner button text { font-size: 24rpx; font-weight: 700; }.panel { background: #fff; border-radius: 28rpx; padding: 27rpx 26rpx; margin-bottom: 18rpx; box-shadow: 0 10rpx 28rpx rgba(20,72,43,.05); }.card-title-row { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1rpx solid #edf2ef; padding-bottom: 21rpx; }.card-title { font-size: 31rpx; font-weight: 700; }.card-caption { color: #91a199; font-size: 20rpx; }.order-stats { display: grid; grid-template-columns: repeat(5,1fr); text-align: center; padding-top: 26rpx; }.stat-icon { font-size: 42rpx; height: 52rpx; }.stat-blue { color: #668ca8; }.stat-lilac { color: #8979a3; }.stat-amber { color: #b18a62; }.stat-slate { color: #778c95; }.stat-green { color: #5c9370; }.stat-number { color: #436154; font-size: 24rpx; font-weight: 700; margin-top: 5rpx; }.stat-label { color: #6f8178; font-size: 19rpx; margin-top: 6rpx; }.function-grid { display: flex; flex-wrap: wrap; justify-content: center; row-gap: 27rpx; text-align: center; padding-top: 27rpx; color: #687a70; font-size: 20rpx; }.function-grid .function-item { width: 25%; box-sizing: border-box; }.function-icon { font-size: 43rpx; height: 53rpx; }.function-blue { color: #668ca8; }.function-lilac { color: #8979a3; }.function-slate { color: #778c95; }.function-amber { color: #b18a62; }.function-teal { color: #5d9586; }.function-rose { color: #a58289; }.function-olive { color: #8f9270; }.admin-note { color: #9aa9a0; text-align: center; font-size: 18rpx; padding: 0 25rpx 25rpx; }.fade-in { animation: rise .45s ease both; }.delay-1 { animation-delay: .08s; } @keyframes rise { from { opacity: 0; transform: translateY(15rpx); } to { opacity: 1; transform: translateY(0); } }
.function-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  height: auto;
  min-height: 78rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

.function-button::after {
  border: 0;
}

/* 固定四列，避免最后一行功能项被 flex 居中后产生不规则空隙。 */
.function-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 8rpx;
  row-gap: 24rpx;
  justify-content: initial;
}

.function-grid .function-item {
  width: 100%;
  min-width: 0;
  min-height: 92rpx;
}

.function-icon {
  line-height: 53rpx;
}

.function-item > view:last-child {
  overflow: hidden;
  margin-top: 7rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 统一为同尺寸的线性图标，避免系统 emoji 在不同设备上漂移。 */
.stat-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin: 0 auto; border-radius: 17rpx; font-size: 21rpx; font-weight: 800; }
.function-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin: 0 auto; border-radius: 19rpx; font-size: 22rpx; font-weight: 800; line-height: 58rpx; }
.stat-blue, .stat-lilac, .stat-amber, .stat-slate, .stat-green,
.function-blue, .function-lilac, .function-slate, .function-amber,
.function-teal, .function-rose, .function-green, .function-olive {
  background: #e8f3ec;
}

/* 底部导航存在时，最后一张卡片仍应完整露出。 */
.profile-scroll {
  padding-bottom: calc(var(--tabbar-space) + var(--safe-bottom));
}

.contact-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(18, 35, 28, .38); }
.contact-sheet { width: 100%; box-sizing: border-box; padding: 34rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #f8fbf8; box-shadow: 0 -16rpx 45rpx rgba(23, 54, 42, .16); animation: contact-rise .22s ease both; }
.contact-sheet-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 0 4rpx 28rpx; }
.contact-sheet-kicker { color: #7e9d8c; font-size: 17rpx; letter-spacing: 2rpx; }
.contact-sheet-title { margin-top: 9rpx; color: #193b2b; font-size: 38rpx; font-weight: 700; }
.contact-sheet-subtitle { margin-top: 8rpx; color: #84988d; font-size: 21rpx; }
.contact-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: #e8f1eb; color: #5c7869; text-align: center; font-size: 38rpx; line-height: 47rpx; }
.contact-group { padding: 22rpx 18rpx 10rpx; border-radius: 22rpx; background: #fff; }
.contact-group-label { margin: 0 4rpx 14rpx; color: #9aac9f; font-size: 19rpx; }
.contact-row { display: flex; align-items: center; min-height: 92rpx; border-top: 1rpx solid #edf2ef; }
.contact-row-icon { width: 52rpx; height: 52rpx; border-radius: 17rpx; background: #e5f2e9; color: #37805a; text-align: center; font-size: 27rpx; line-height: 52rpx; }
.contact-row-main { flex: 1; min-width: 0; margin-left: 16rpx; }
.contact-row-name { color: #294b3a; font-size: 24rpx; font-weight: 600; }
.contact-row-number { margin-top: 5rpx; color: #8b9d92; font-size: 21rpx; letter-spacing: 1rpx; }
.contact-row-action { padding: 11rpx 20rpx; border-radius: 22rpx; background: #e8f4ec; color: #32774f; font-size: 20rpx; }
@keyframes contact-rise { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
