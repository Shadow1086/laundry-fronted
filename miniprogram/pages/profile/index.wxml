<view class="profile-shell"><scroll-view class="profile-scroll" scroll-y="true" enhanced="true" show-scrollbar="false"><view class="profile-head"><view class="profile-identity"><view class="profile-kicker">易净洗护账号</view><view class="profile-name">{{userName}}</view><view class="profile-phone"><text class="phone-status-dot"></text>{{phone}}</view></view><view class="profile-edit" bindtap="editProfile">账号信息 ›</view></view>
  <view class="member-banner fade-in"><view><view class="member-eyebrow">EASY CLEAN MEMBER</view><view class="member-title">易净会籍身份</view><view class="member-desc">一年有效 · 享分类会员价</view></view><button bindtap="openMember">立即办理 <text>36¥</text></button></view>
  <view class="panel fade-in"><view class="card-title-row"><view class="card-title">我的订单</view><view class="card-caption" bindtap="goOrders">查看全部 ›</view></view><view class="order-stats"><view wx:for="{{orderStats}}" wx:key="label" bindtap="goOrders"><view class="stat-icon {{item.tone}}">{{item.icon}}</view><view class="stat-number">{{item.count}}</view><view class="stat-label">{{item.label}}</view></view></view></view>
  <view class="panel fade-in delay-1"><view class="card-title-row"><view class="card-title">常用功能</view><view class="card-caption">快捷服务</view></view><view class="function-grid"><view wx:for="{{functions}}" wx:key="label" class="function-item" bindtap="onFunction" data-label="{{item.label}}"><view class="function-icon {{item.tone}}">{{item.icon}}</view><view>{{item.label}}</view></view><view class="function-item" bindtap="goAdmin"><view class="function-icon function-olive">⚙</view><view>管理员入口</view></view></view></view>
  <view class="admin-note">管理员入口对所有用户可见，实际权限由服务端校验。</view>
</scroll-view></view>
