<view class="edit-page">
  <view class="edit-hero">
    <view class="edit-kicker">ACCOUNT PROFILE</view>
    <view class="edit-title">账号信息</view>
    <view class="edit-copy">更新你的称呼和联系方式，让订单通知准确送达。</view>
  </view>

  <view class="edit-card">
    <view class="field-block">
      <view class="field-label">用户名</view>
      <input class="field-input" value="{{username}}" maxlength="30" placeholder="请输入用户名" bindinput="handleUsernameInput" />
      <view class="field-hint">用于首页欢迎语和订单展示</view>
    </view>

    <view class="field-block phone-block">
      <view class="field-label-row"><view class="field-label">手机号</view><view class="bound-state {{phoneBound ? 'is-bound' : ''}}">{{phoneBound ? '已绑定' : '未绑定'}}</view></view>
      <view class="phone-row"><view class="phone-value">{{phoneBound ? mobile : '请授权手机号'}}</view><button class="phone-auth" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneNumber" loading="{{phoneLoading}}" disabled="{{phoneLoading}}">{{phoneLoading ? '授权中' : '重新授权'}}</button></view>
      <view class="field-hint">手机号由微信授权获取，不能手动输入</view>
    </view>

    <view wx:if="{{message}}" class="edit-message">{{message}}</view>
    <view class="edit-actions"><view class="cancel-action" bindtap="cancel">取消</view><view class="save-action {{saving ? 'is-saving' : ''}}" bindtap="saveProfile">{{saving ? '保存中…' : '保存资料'}}</view></view>
  </view>
</view>
