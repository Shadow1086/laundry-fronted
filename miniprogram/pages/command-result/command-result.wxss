page { background: #f3f6f4; color: #17231f; font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif; }

.shell { min-height: 100vh; padding: 28rpx 24rpx calc(72rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.status-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
  border: 1rpx solid #edf1ee;
  box-shadow: 0 12rpx 32rpx rgba(24, 55, 40, .06);
}

.hero-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 750;
  color: #1f3027;
}

.hero-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b9892;
  line-height: 1.6;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #cdd8d0;
  border-top-color: #358761;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 700;
}
.hero-icon image { width: 52rpx; height: 52rpx; }

.success .hero-icon, .done .hero-icon { background: #e8f5ee; color: #286e4f; }
.error .hero-icon { background: #fdf0e0; color: #7a4a0a; font-size: 42rpx; }

.status-hero.failure-status {
  padding: 64rpx 24rpx 32rpx;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}
.failure-status .hero-icon { width: 100rpx; height: 100rpx; background: #fff0d9; }
.failure-status .hero-icon image { width: 60rpx; height: 60rpx; }
.failure-status .hero-title { margin-top: 28rpx; font-size: 36rpx; line-height: 1.4; }
.failure-context { margin-top: 16rpx; font-size: 24rpx; color: #67776f; }
.failure-status .hero-hint { width: 100%; margin-top: 24rpx; color: #705126; font-size: 26rpx; overflow-wrap: anywhere; word-break: break-word; }
.failure-actions { width: 100%; max-width: 620rpx; margin: 0 auto; }
.failure-note { padding: 0 12rpx 28rpx; color: #67776f; font-size: 24rpx; line-height: 1.7; text-align: center; }
.failure-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  min-height: 96rpx;
  height: auto;
  padding: 22rpx 20rpx;
  margin: 0 0 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  white-space: normal;
  box-sizing: border-box;
}
.failure-button::after, .failure-link::after { border: 0; }
.failure-button.primary { color: #fff; background: #286e4f; }
.failure-button.secondary { color: #283d32; background: #fff; border: 1rpx solid #d7e1da; }
.failure-button[disabled] { opacity: .55; }
.action-icon { flex-shrink: 0; width: 32rpx; height: 32rpx; }
.primary .action-icon { filter: brightness(0) invert(1); }
.failure-footer { display: flex; justify-content: center; padding-top: 8rpx; }
.failure-link { margin: 0; padding: 16rpx 24rpx; min-height: 80rpx; color: #42654f; font-size: 26rpx; line-height: 1.7; background: transparent; }

.card {
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 22rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3027;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #8b9892;
  margin-bottom: 28rpx;
  line-height: 1.6;
}

.card-actions { display: flex; gap: 16rpx; }
.card-actions.stacked { flex-direction: column; }

.btn-primary, .btn-secondary, .btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary   { flex: 2; color: #fff; background: #286e4f; }
.btn-secondary { flex: 1; color: #566b60; background: #eef2ef; }
.btn-outline   { flex: 1; color: #286e4f; background: #fff; border: 2rpx solid #c0deca; }
.btn-loading   { background: #7aaa8f; }
.btn-hover     { opacity: 0.72; }

.exception-section {
  background: #fff;
  border-radius: 22rpx;
  padding: 0 28rpx;
  overflow: hidden;
}

.exception-title {
  padding: 22rpx 0 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #4a6457;
  letter-spacing: 0;
  border-bottom: 1rpx solid #edf0ed;
}

.exception-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 16rpx 0;
}

.exception-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f3027;
}

.exception-arrow { font-size: 32rpx; color: #8b9892; }
.exception-hover { background: #f8faf8; }

.done-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
