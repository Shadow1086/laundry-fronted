<view class="admin-page">
  <view class="admin-mark"><image src="/assets/icons/shield-check.svg" mode="aspectFit" /></view>
  <view class="admin-kicker">ADMIN CONSOLE</view>
  <view class="admin-title">管理员功能</view>
  <view class="admin-copy">这里将承载门店、柜机与订单管理能力。入口按当前账号角色显示，实际管理员权限仍由服务端校验。</view>

  <view class="entry-list">
    <view wx:if="{{canManager}}" class="entry-item" hover-class="entry-hover" bindtap="goAreaManager">
      <view class="entry-icon entry-icon-green"><image src="/assets/icons/truck.svg" mode="aspectFit" /></view>
      <view class="entry-info">
        <view class="entry-title">区域管理员</view>
        <view class="entry-desc">扫码取货 / 送货，开柜操作</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
    <view wx:if="{{canStaff}}" class="entry-item" hover-class="entry-hover" bindtap="goLaundryStaff">
      <view class="entry-icon entry-icon-amber"><image src="/assets/icons/washing-machine.svg" mode="aspectFit" /></view>
      <view class="entry-info">
        <view class="entry-title">洗衣店员工</view>
        <view class="entry-desc">洗前拍照存档，洗后核对完成</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <view class="admin-status">
    <view class="status-dot"></view>
    <view>
      <view class="status-title">权限安全已启用</view>
      <view class="status-copy">入口仅按角色展示，服务端会再次校验每次操作</view>
    </view>
  </view>
</view>
