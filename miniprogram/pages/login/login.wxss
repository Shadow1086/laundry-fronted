page { background: #eff5f1; color: #173126; }
.login-page { min-height: 100vh; box-sizing: border-box; padding: 126rpx 34rpx 52rpx; position: relative; overflow: hidden; background: radial-gradient(circle at 12% 8%, #d8f4df 0, #eff5f1 38%), #eff5f1; }
.login-orb { position: absolute; border-radius: 50%; border: 1rpx solid rgba(35, 142, 86, .12); pointer-events: none; }.orb-a { width: 430rpx; height: 430rpx; top: -215rpx; right: -175rpx; }.orb-b { width: 260rpx; height: 260rpx; bottom: -120rpx; left: -100rpx; background: rgba(255, 214, 117, .13); }
.login-brand { position: relative; display: flex; align-items: center; gap: 20rpx; }.brand-mark { width: 84rpx; height: 84rpx; border-radius: 28rpx 42rpx 34rpx 44rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #166d4d; font-size: 40rpx; font-weight: 700; transform: rotate(-8deg); box-shadow: 0 12rpx 25rpx rgba(22,109,77,.2); }.brand-name { font-size: 42rpx; font-weight: 700; letter-spacing: 2rpx; }.brand-caption { color: #739184; font-size: 21rpx; margin-top: 7rpx; letter-spacing: 1rpx; }
.login-card { position: relative; margin-top: 80rpx; padding: 42rpx 32rpx 32rpx; border-radius: 36rpx; background: rgba(255,255,255,.94); box-shadow: 0 22rpx 60rpx rgba(33, 91, 59, .1); }.login-kicker { color: #3e9667; font-size: 18rpx; letter-spacing: 3rpx; font-weight: 700; }.login-title { font-size: 46rpx; font-weight: 700; margin-top: 16rpx; }.login-copy { color: #80948a; font-size: 23rpx; line-height: 1.65; margin-top: 13rpx; }
.phone-preview { display: flex; align-items: center; gap: 18rpx; padding: 23rpx 0 26rpx; margin-top: 22rpx; border-bottom: 1rpx solid #edf2ee; }.phone-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; color: #1b8256; background: #daf2e2; border-radius: 24rpx; font-size: 34rpx; }.phone-preview-copy { flex: 1; }.phone-preview-title { color: #263c31; font-size: 28rpx; font-weight: 700; }.phone-preview-note { color: #8a9b92; font-size: 20rpx; margin-top: 8rpx; }button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 48rpx; font-size: 27rpx; height: 88rpx; line-height: 1; margin: 20rpx 0 0; }.phone-button { color: #fff; background: #17784f; box-shadow: 0 14rpx 28rpx rgba(23,120,79,.2); }.phone-button::after { border: none; }.inline-message { font-size: 21rpx; line-height: 1.5; padding: 16rpx 19rpx; border-radius: 15rpx; margin-top: 17rpx; }.inline-message.info { color: #527b68; background: #eef7f1; }.inline-message.success { color: #28764e; background: #e6f6eb; }.inline-message.error { color: #a45f56; background: #fff0ed; }.login-foot { text-align: center; color: #a0aea7; font-size: 18rpx; line-height: 1.5; margin-top: 26rpx; }
