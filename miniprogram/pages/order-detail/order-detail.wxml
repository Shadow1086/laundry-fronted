<view class="detail-shell">
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-dot"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:elif="{{loadError}}" class="loading-state">
    <view class="loading-text">{{loadError}}</view>
  </view>
  <block wx:elif="{{order}}">
    <view class="status-header status-{{statusInfo.color}}">
      <view class="status-main">
        <view class="status-label">{{statusInfo.label}}</view>
        <view class="status-hint">{{statusInfo.hint}}</view>
      </view>
      <view class="status-badge"><image src="{{statusInfo.icon}}" mode="aspectFit" /></view>
    </view>

    <view class="progress-track">
      <view wx:for="{{progressSteps}}" wx:key="key" class="progress-step {{item.done ? 'step-done' : ''}} {{item.active ? 'step-active' : ''}}">
        <view class="step-dot"></view>
        <view class="step-name">{{item.name}}</view>
        <view wx:if="{{item.time}}" class="step-time">{{item.time}}</view>
      </view>
    </view>

    <view wx:if="{{order.items.length}}" class="section">
      <view class="section-head">洗护衣物</view>
      <view wx:for="{{order.items}}" wx:key="name" class="item-row">
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view wx:if="{{item.categoryName}}" class="item-category">{{item.categoryName}}</view>
        </view>
        <view class="item-right">
          <view class="item-count">x {{item.count}}</view>
          <view wx:if="{{item.hasPrice}}" class="item-price">¥{{item.price}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{order.imageUrls.length}}" class="section">
      <view class="section-head">验衣图片</view>
      <view class="photo-grid">
        <image
          wx:for="{{order.imageUrls}}"
          wx:key="*this"
          class="inspection-photo"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="previewImage"
        />
      </view>
    </view>

    <view class="section">
      <view class="section-head">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value info-id">{{order.orderNo || '待生成'}}</text>
      </view>
      <view wx:if="{{order.hasDeliveryCode}}" class="info-row pickup-code-row">
        <text class="info-label">取货码</text>
        <text
          class="info-value pickup-code"
          hover-class="pickup-code-hover"
          catchtap="copyDeliveryCode"
        >{{order.deliveryCode}}</text>
      </view>
      <view wx:if="{{order.userPhone}}" class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{order.userPhone}}</text>
      </view>
      <view wx:if="{{order.cabinetName}}" class="info-row">
        <text class="info-label">柜机名称</text>
        <text class="info-value">{{order.cabinetName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">所属处理点</text>
        <text class="info-value">{{order.serviceSiteName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">处理点电话</text>
        <text class="info-value">{{order.serviceSitePhone || '-'}}</text>
      </view>
      <view wx:if="{{order.hasDepositCompartmentNo}}" class="info-row">
        <text class="info-label">存衣格口编号</text>
        <text class="info-value">{{order.depositCompartmentNo}}</text>
      </view>
      <view wx:if="{{order.hasReturnCompartmentNo}}" class="info-row">
        <text class="info-label">返衣格口编号</text>
        <text class="info-value">{{order.returnCompartmentNo}}</text>
      </view>
      <view wx:if="{{order.hasRewashRound}}" class="info-row">
        <text class="info-label">返洗轮次</text>
        <text class="info-value">第 {{order.rewashRound}} 轮</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">价格信息</view>
      <view wx:if="{{order.hasEstimatedOriginalAmount}}" class="info-row">
        <text class="info-label">预估原价</text>
        <text class="info-value">¥{{order.estimatedOriginalAmountLabel}}</text>
      </view>
      <view wx:if="{{order.hasEstimatedPayableAmount}}" class="info-row">
        <text class="info-label">预估应付</text>
        <text class="info-value price-confirmed">¥{{order.estimatedPayableAmountLabel}}</text>
      </view>
      <view wx:if="{{order.hasFinalOriginalAmount}}" class="info-row">
        <text class="info-label">最终原价</text>
        <text class="info-value">¥{{order.finalOriginalAmountLabel}}</text>
      </view>
      <view wx:if="{{order.hasFinalPayableAmount}}" class="info-row">
        <text class="info-label">最终应付</text>
        <text class="info-value price-confirmed">¥{{order.finalPayableAmountLabel}}</text>
      </view>
      <view wx:if="{{!order.hasFinalPayableAmount}}" class="info-row">
        <text class="info-label">最终应付</text>
        <text class="info-value info-pending">商家验衣后确认</text>
      </view>
    </view>

    <view
      wx:if="{{order.canDeposit || order.canCancel || order.canPay || order.canPickup || order.canApplyRewash}}"
      class="action-section"
    >
      <view
        wx:if="{{order.canDeposit}}"
        class="btn-primary {{actionSubmitting ? 'btn-disabled' : ''}}"
        hover-class="{{actionSubmitting ? '' : 'btn-hover'}}"
        catchtap="openDeposit"
      >{{actionSubmitting ? '处理中...' : (order.isRewashDeposit ? '选择柜机并开柜存衣' : '开柜存衣')}}</view>
      <view
        wx:if="{{order.canPay}}"
        class="btn-primary {{paymentSubmitting ? 'btn-disabled' : ''}}"
        hover-class="{{paymentSubmitting ? '' : 'btn-hover'}}"
        bindtap="payOrder"
      >{{paymentSubmitting ? '支付中...' : '去支付'}}</view>
      <view
        wx:if="{{order.canCancel}}"
        class="btn-danger {{actionSubmitting || paymentSubmitting ? 'btn-disabled' : ''}}"
        hover-class="btn-hover"
        bindtap="cancelOrder"
      >{{actionSubmitting ? '取消中...' : '取消订单'}}</view>
      <view
        wx:if="{{order.canPickup}}"
        class="btn-primary {{actionSubmitting ? 'btn-disabled' : ''}}"
        hover-class="{{actionSubmitting ? '' : 'btn-hover'}}"
        bindtap="scanPickup"
      >{{order.canPickupCancelledOrder ? '取出衣物' : '取衣开柜'}}</view>
      <view
        wx:if="{{order.canApplyRewash}}"
        class="btn-secondary {{actionSubmitting || order.rewashRequested ? 'btn-disabled' : ''}}"
        hover-class="btn-hover"
        bindtap="applyRewash"
      >{{order.rewashRequested ? '返洗申请已提交' : (actionSubmitting ? '提交中...' : '申请返洗')}}</view>
    </view>
  </block>
</view>
