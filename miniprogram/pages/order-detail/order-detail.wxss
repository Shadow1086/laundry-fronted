page { background: #f3f6f4; color: #17231f; font-family: 'PingFang SC', 'Hiragino Sans GB', sans-serif; }

.detail-shell { padding: 0 0 60rpx; }

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: #9aaa9f;
  font-size: 23rpx;
}

.loading-dot {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid #cdd8d0;
  border-top-color: #358761;
  border-radius: 50%;
}

.loading-text { color: #9aaa9f; font-size: 23rpx; }

.status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 36rpx 40rpx;
  color: #fff;
}

.status-created  { background: linear-gradient(130deg, #1a3a78 0%, #2d5db8 100%); }
.status-cleaning { background: linear-gradient(130deg, #7a4a0a 0%, #c47c18 100%); }
.status-ready    { background: linear-gradient(130deg, #0f3d28 0%, #246e4a 100%); }
.status-completed { background: linear-gradient(130deg, #2a3630 0%, #485e52 100%); }

.status-label {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.status-hint {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, .65);
  font-size: 22rpx;
}

.status-badge {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .12);
  border: 1rpx solid rgba(255, 255, 255, .2);
  border-radius: 50%;
  font-size: 34rpx;
  flex-shrink: 0;
}

.progress-track {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 32rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #edf0ed;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
  color: #b5c0ba;
  font-size: 19rpx;
}

.progress-step::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: calc(50% + 14rpx);
  right: calc(-50% + 14rpx);
  height: 2rpx;
  background: #dde4de;
}

.progress-step:last-child::before { display: none; }

.step-done::before, .step-active::before { background: #358761; }

.step-dot {
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 10rpx;
  box-sizing: border-box;
  border: 3rpx solid #d4dcd5;
  border-radius: 50%;
  background: #fff;
  position: relative;
  z-index: 1;
}

.step-done .step-dot {
  background: #358761;
  border-color: #358761;
}

.step-active .step-dot {
  background: #fff;
  border-color: #358761;
  box-shadow: 0 0 0 6rpx rgba(53, 135, 97, .15);
}

.step-name { line-height: 1.3; text-align: center; }
.step-done .step-name, .step-active .step-name { color: #2e6f4e; font-weight: 600; }

.section {
  margin: 16rpx 24rpx 0;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
}

.section-head {
  padding: 24rpx 0 16rpx;
  color: #4a6457;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border-bottom: 1rpx solid #edf0ed;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f3f0;
}

.item-row:last-child { border-bottom: 0; }

.item-name {
  color: #1f3027;
  font-size: 26rpx;
  font-weight: 600;
}

.item-category {
  margin-top: 5rpx;
  color: #8b9892;
  font-size: 19rpx;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-count { color: #8b9892; font-size: 21rpx; }

.item-price {
  color: #2c9758;
  font-size: 25rpx;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f3f0;
  font-size: 24rpx;
}

.info-row:last-child { border-bottom: 0; }

.info-label { color: #8b9892; flex-shrink: 0; }

.info-value { color: #1f3027; text-align: right; }

.info-id { color: #6a7e74; font-size: 20rpx; letter-spacing: 1rpx; }

.info-pending { color: #9aaa9f; font-size: 21rpx; }

.price-confirmed { color: #2c9758; font-weight: 700; }

.action-section {
  margin: 24rpx 24rpx 0;
}

.btn-primary, .btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary { color: #fff; background: #286e4f; }
.btn-secondary { color: #286e4f; background: #eaf4ee; border: 1rpx solid #c0deca; }
.btn-hover { opacity: .72; }
