page { background: #f3f6f4; }
.map-page { position: relative; height: 100vh; overflow: hidden; background: #e9f1ec; }
.cabinet-map { width: 100%; height: 100%; }
.map-topbar { position: absolute; top: 24rpx; left: 24rpx; right: 24rpx; padding: 22rpx 26rpx; background: rgba(255,255,255,.94); border: 1rpx solid #e5eee8; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(20,72,43,.10); }
.map-title { color: #173126; font-size: 32rpx; font-weight: 700; }.map-subtitle { margin-top: 5rpx; color: #789087; font-size: 20rpx; }.map-location { margin-top: 8rpx; color: #527b68; font-size: 19rpx; line-height: 1.45; }
.map-actions { position: absolute; right: 24rpx; bottom: 190rpx; display: flex; flex-direction: column; gap: 12rpx; }.map-action { display: flex; align-items: center; gap: 9rpx; padding: 12rpx 18rpx 12rpx 12rpx; color: #286e4f; background: #fff; border-radius: 18rpx; box-shadow: 0 6rpx 18rpx rgba(20,72,43,.10); font-size: 21rpx; }.map-action image { display: block; width: 38rpx; height: 38rpx; padding: 8rpx; box-sizing: border-box; border-radius: 12rpx; background: #e4f2e9; }
.map-message, .map-loading { position: absolute; top: 142rpx; left: 24rpx; right: 24rpx; padding: 14rpx 18rpx; color: #7c6a3e; background: rgba(255,250,232,.95); border-radius: 12rpx; text-align: center; font-size: 20rpx; }.map-loading { color: #527b68; background: rgba(238,247,241,.95); }
.store-sheet { position: absolute; left: 20rpx; right: 20rpx; bottom: 30rpx; padding: 24rpx 26rpx; background: rgba(255,255,255,.97); border-radius: 22rpx; box-shadow: 0 10rpx 28rpx rgba(20,72,43,.14); }.sheet-head { display: flex; align-items: center; justify-content: space-between; }.sheet-title { color: #173126; font-size: 29rpx; font-weight: 700; }.sheet-close { color: #8b9892; font-size: 38rpx; line-height: 1; }.sheet-address { margin-top: 10rpx; color: #71847a; font-size: 21rpx; }.sheet-meta { display: flex; gap: 22rpx; margin-top: 16rpx; color: #286e4f; font-size: 20rpx; }
