page { background: #f3f6f4; color: #173126; }
.pickup-page { min-height: 100vh; padding: 56rpx 30rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: radial-gradient(circle at 100% 0, #dff0e5 0, #f3f6f4 38%); }
.page-kicker { color: #5d8d75; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.page-title { margin-top: 12rpx; font-size: 46rpx; font-weight: 800; }
.page-copy { margin-top: 12rpx; color: #71847a; font-size: 23rpx; line-height: 1.6; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 40rpx; padding: 0 4rpx; }
.section-title { color: #29483a; font-size: 26rpx; font-weight: 700; }
.section-link { color: #5d7c6c; font-size: 21rpx; }
.cabinet-picker { margin-top: 18rpx; border: 1rpx solid #dce8e0; border-radius: 18rpx; background: rgba(255,255,255,.92); }
.cabinet-picker-content { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.cabinet-picker-label { color: #819188; font-size: 19rpx; }
.cabinet-picker-value { margin-top: 7rpx; color: #29483a; font-size: 25rpx; font-weight: 700; }
.cabinet-picker-arrow { color: #5d8d75; font-size: 32rpx; line-height: 1; }
.loading-panel, .empty-panel { margin-top: 18rpx; padding: 46rpx 24rpx; border: 1rpx solid #e1e9e4; border-radius: 20rpx; color: #819188; background: rgba(255,255,255,.88); text-align: center; font-size: 22rpx; }
.loading-dot { width: 34rpx; height: 34rpx; margin: 0 auto 16rpx; border: 3rpx solid #d2dfd7; border-top-color: #358761; border-radius: 50%; animation: spin .8s linear infinite; }
.empty-title { color: #3c584a; font-size: 25rpx; font-weight: 600; }
.empty-copy { margin-top: 8rpx; color: #91a097; font-size: 21rpx; }
.order-list { margin-top: 18rpx; }
.pickup-order { display: flex; align-items: center; gap: 22rpx; margin-top: 14rpx; padding: 22rpx 20rpx 22rpx 24rpx; border: 1rpx solid #e1e9e4; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 24rpx rgba(23,76,49,.05); }
.order-main { flex: 1; min-width: 0; }
.order-status { display: inline-flex; align-items: center; padding: 6rpx 14rpx; border-radius: 9rpx; font-size: 18rpx; font-weight: 700; line-height: 1.1; }
.status-ready { color: #17623f; background: #e3f2e8; }
.status-blocked { color: #866122; background: #fff1d8; }
.order-location { margin-top: 12rpx; overflow: hidden; color: #203a2e; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.order-meta { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; margin-top: 7rpx; color: #819188; font-size: 20rpx; }
.order-category { display: -webkit-box; overflow: hidden; margin-top: 9rpx; color: #527060; font-size: 21rpx; line-height: 1.35; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.order-open { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 136rpx; min-height: 72rpx; padding: 0 10rpx; border-radius: 16rpx; color: #fff; background: #286e4f; font-size: 25rpx; font-weight: 700; }
.pickup-divider { display: flex; align-items: center; gap: 18rpx; margin: 36rpx 4rpx 0; color: #7e9186; font-size: 21rpx; }
.pickup-divider text { flex: 1; height: 1rpx; background: #d9e3dd; }
.code-panel { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid #e1e9e4; border-radius: 20rpx; background: rgba(255,255,255,.95); box-shadow: 0 16rpx 38rpx rgba(23,76,49,.07); }
.code-title { color: #29483a; font-size: 26rpx; font-weight: 700; }
.code-copy { margin-top: 8rpx; color: #8b9a92; font-size: 20rpx; }
.code-input { height: 92rpx; margin-top: 22rpx; padding: 0 24rpx; border: 2rpx solid #cddfd4; border-radius: 14rpx; color: #173126; background: #f8fbf9; font-size: 38rpx; font-weight: 700; letter-spacing: 16rpx; text-align: center; }
.code-placeholder { color: #a4b1aa; font-size: 24rpx; font-weight: 400; letter-spacing: 0; }
.primary-button, .outline-button { display: flex; align-items: center; justify-content: center; height: 86rpx; border-radius: 16rpx; font-size: 27rpx; font-weight: 700; }
.primary-button { margin-top: 24rpx; color: #fff; background: #286e4f; box-shadow: 0 12rpx 26rpx rgba(40,110,79,.18); }
.is-disabled { color: rgba(255,255,255,.78); background: #9aaca2; box-shadow: none; }
.safe-tip { display: flex; gap: 14rpx; margin-top: 20rpx; padding: 22rpx; color: #71847a; background: rgba(255,255,255,.72); border-radius: 18rpx; font-size: 20rpx; line-height: 1.6; }
.safe-tip image { flex-shrink: 0; width: 30rpx; height: 30rpx; margin-top: 1rpx; }
.success-panel { padding-top: 180rpx; text-align: center; }
.success-icon { display: flex; align-items: center; justify-content: center; width: 130rpx; height: 130rpx; margin: 0 auto; border-radius: 50%; background: #dff0e5; }
.success-icon image { width: 70rpx; height: 70rpx; }
.success-title { margin-top: 34rpx; font-size: 46rpx; font-weight: 800; }
.success-copy { margin-top: 16rpx; color: #527060; font-size: 28rpx; }
.success-note { margin-top: 52rpx; padding: 26rpx; color: #71847a; border-radius: 18rpx; background: rgba(255,255,255,.8); font-size: 22rpx; }
.done-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 48rpx; }
.done-actions .primary-button { margin-top: 0; }
.outline-button { color: #286e4f; border: 2rpx solid #b9d3c4; background: transparent; }
@keyframes spin { to { transform: rotate(360deg); } }
