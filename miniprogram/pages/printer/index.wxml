<view class="page">
  <view class="toolbar">
    <button bindtap="scan" loading="{{scanning}}">搜索打印机</button>
    <button bindtap="stopScan" disabled="{{!scanning}}">停止搜索</button>
  </view>
  <view class="scan-state" wx:if="{{scanning && !devices.length}}">正在搜索附近的蓝牙设备…</view>
  <view class="scan-state" wx:if="{{scanCompleted && !devices.length}}">没有发现蓝牙设备，请确认打印机已开机并靠近手机后重试。</view>
  <view class="device-list" wx:if="{{devices.length}}">
    <view class="device" wx:for="{{devices}}" wx:key="deviceId" bindtap="connect" data-index="{{index}}">
      <view>{{item.name || '未命名设备'}}</view>
      <view class="device-id">{{item.deviceId}}</view>
    </view>
  </view>
  <view class="connected" wx:if="{{connected}}">已连接：{{deviceName}}</view>

  <view class="toolbar" wx:if="{{connected}}">
    <button type="primary" bindtap="print" loading="{{printing}}">打印标签</button>
    <button bindtap="stopPrint" disabled="{{!printing}}">停止打印</button>
    <button bindtap="disconnect">断开连接</button>
  </view>

  <view class="hint">请保持打印机开机并靠近手机。打印成功后，系统会记录本次打印审计。</view>

  <view style="position: fixed; top: 9999px;">
    <canvas canvas-id="Canvas" id="Canvas" width="{{templateWidth}}" height="{{templateHeight}}" style="width:{{templateWidth}}px;height:{{templateHeight}}px"></canvas>
    <canvas type="2d" canvas-id="barCodels" id="barCodels" width="{{barCodeWidth * pixelRatio}}" height="{{barCodeHeight * pixelRatio}}" style="width:{{barCodeWidth}}px;height:{{barCodeHeight}}px"></canvas>
    <canvas type="2d" canvas-id="qrCode" id="qrCode" width="{{qrCodeWidth * pixelRatio}}" height="{{qrCodeHeight * pixelRatio}}" style="width:{{qrCodeWidth}}px;height:{{qrCodeHeight}}px"></canvas>
  </view>
</view>
