<view class="list-shell">

  <view class="list-intro">
    <view>
      <view class="page-kicker">LAUNDRY JOURNEY</view>
      <view class="page-title">我的订单</view>
    </view>
    <view class="order-count" wx:if="{{orders.length}}"><text>{{orders.length}}</text> 笔</view>
  </view>

  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-tab {{activeFilter === item.key ? 'tab-active' : ''}}"
      bindtap="tapFilter"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-dot"></view>
    <view class="loading-text">加载中…</view>
  </view>

  <block wx:elif="{{!filtered.length}}">
    <empty-state title="暂无订单" description="快去首页下单，开启洗护之旅" />
  </block>

  <block wx:else>
    <view
      wx:for="{{filtered}}"
      wx:key="orderId"
      class="order-card"
      hover-class="card-hover"
      bindtap="goDetail"
      data-order-id="{{item.orderId}}"
    >
      <view class="card-top">
        <view class="card-location-wrap">
          <view class="card-location">{{item.locationLabel}}</view>
          <view class="card-number">{{item.orderNo || '订单号待生成'}}</view>
        </view>
        <view class="status-tag tone-{{item.statusConfig.tone}}">{{item.statusConfig.label}}</view>
      </view>
      <view class="card-time">最近更新于 {{item.updatedAtLabel}} · 创建于 {{item.createdAtLabel}}</view>
      <view class="category-row">
        <text class="category-label">衣物分类</text>
        <text class="category-value">{{item.categorySummary}}</text>
      </view>
      <view class="pickup-code-row">
        <text class="pickup-code-label">取货码</text>
        <text class="pickup-code-value {{item.hasValidDeliveryCode ? '' : 'code-unavailable'}}">{{item.deliveryCodeLabel}}</text>
      </view>
      <view class="card-footer">
        <view class="price-group">
          <view class="price-row">
            <text class="price-label">预估价格</text>
            <text class="price-val estimate">¥{{item.estimateLabel}}</text>
          </view>
          <view wx:if="{{item.hasPayableAmount}}" class="price-row payable-row">
            <text class="price-label">应付价格</text>
            <text class="price-val">¥{{item.payableLabel}}</text>
          </view>
        </view>
        <view class="detail-link">查看详情 <text class="detail-arrow">→</text></view>
      </view>
    </view>
  </block>

</view>
