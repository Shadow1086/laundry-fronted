.login-sheet {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
}
.login-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 35, 26, .4);
}
.login-content {
    position: relative;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 40rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
    border-radius: 16rpx 16rpx 0 0;
    background: #fff;
}
.login-heading { color: #173126; font-size: 34rpx; font-weight: 600; }
.login-description { margin-top: 16rpx; color: #75847c; font-size: 25rpx; line-height: 1.6; }
.login-primary { margin: 28rpx 0 0; background: #17784f; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.login-primary[disabled] { background: #4b9374; color: #fff; }
.login-primary::after, .login-cancel::after { border: none; }
.login-message { margin-top: 16rpx; color: #a45f56; font-size: 24rpx; line-height: 1.5; }
.login-consent { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 20rpx; font-size: 23rpx; line-height: 40rpx; color: #6c7b73; }
.login-check { flex: 0 0 48rpx; }
.login-check-target { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-top: -4rpx; }
.login-check checkbox { transform: scale(.68); }
.login-agreements { flex: 1; min-width: 0; overflow-wrap: break-word; }
.login-link { color: #286e4f; }
.login-cancel { margin: 20rpx 0 0; background: transparent; color: #75847c; font-size: 25rpx; }
