.guide-mask {
    position: fixed;
    z-index: 110;
    background: rgba(10, 35, 26, .58);
}
.guide-highlight {
    position: fixed;
    z-index: 111;
    box-sizing: border-box;
    border: 3px solid #b8efc7;
    border-radius: 8px;
    pointer-events: none;
}
.guide-panel {
    position: fixed;
    z-index: 112;
    box-sizing: border-box;
    border-radius: 12px;
    background: var(--surface, #ffffff);
    color: var(--ink-900, #17231f);
}
.guide-arrow {
    position: absolute;
    width: 0;
    height: 0;
    margin-left: -8px;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
}
.guide-arrow-below {
    top: -12px;
    border-bottom: 12px solid var(--surface, #ffffff);
}
.guide-arrow-above {
    bottom: -12px;
    border-top: 12px solid var(--surface, #ffffff);
}
.guide-header {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    gap: 8px;
}
.guide-progress {
    font-size: 13px;
    color: var(--ink-600, #566b60);
}
.guide-scroll {
    min-height: 0;
    width: 100%;
}
.guide-body {
    padding: 0 16px 8px;
    overflow-wrap: break-word;
    word-break: break-all;
}
.guide-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--brand-900, #15382a);
}
.guide-description {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-600, #566b60);
}
.guide-item {
    margin-top: 12px;
}
.guide-item-label {
    font-size: 14px;
    line-height: 1.5;
    font-weight: 600;
}
.guide-last-hint {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #e5ece7;
    color: var(--brand-700, #236b4b);
    font-size: 14px;
    line-height: 1.55;
}
.guide-footer {
    box-sizing: border-box;
    height: 68px;
    padding: 12px 16px;
}
.guide-controls {
    display: flex;
    gap: 8px;
}
.guide-button {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0 8px;
    box-sizing: border-box;
    font-size: 14px;
    line-height: 1.5;
    border-radius: 6px;
    background: transparent;
    color: var(--brand-700, #236b4b);
}
.guide-button::after { border: none; }
.guide-button:focus { outline: 2px solid var(--brand-700, #236b4b); outline-offset: -2px; }
.guide-close { flex: none; }
.guide-previous { background: var(--canvas, #f3f6f4); }
.guide-previous[disabled] { color: var(--ink-600, #566b60); }
.guide-next { background: var(--brand-700, #236b4b); color: var(--surface, #ffffff); }
