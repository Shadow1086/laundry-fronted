.empty-state { color: #81948a; padding: 116rpx 40rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin: 0 auto 28rpx; border: 1rpx solid #d6e5dc; border-radius: 30rpx; color: #2f805b; background: linear-gradient(145deg,#f8fcf9,#e4f2e9); font-size: 34rpx; font-weight: 800; box-shadow: 0 14rpx 34rpx rgba(24,91,58,.08); }
.empty-mark image { width: 42rpx; height: 42rpx; }
.empty-title { color: #385648; font-size: 30rpx; font-weight: 700; }
.empty-copy { font-size: 21rpx; line-height: 1.6; margin-top: 12rpx; }
